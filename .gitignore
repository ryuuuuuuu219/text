# Unity-generated metadata for IDE files
/AirKnight/*.pidb.meta
/AirKnight/*.pdb.meta
/AirKnight/*.mdb.meta

# Crash reports
/AirKnight/sysinfo.txt
/AirKnight/crashlytics-build.properties
/AirKnight/[Cc]rash*/

# Packaged builds and exported applications
/AirKnight/*.apk
/AirKnight/*.aab
/AirKnight/*.unitypackage
/AirKnight/*.app

# Addressables build output
/AirKnight/Assets/AddressableAssetsData/*/*.bin*
/AirKnight/Assets/StreamingAssets/aa.meta
/AirKnight/Assets/StreamingAssets/aa/

# Temporary Android build assets
/AirKnight/Assets/StreamingAssets/Android.meta
/AirKnight/Assets/StreamingAssets/Android/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
